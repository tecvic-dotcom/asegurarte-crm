# ============================================================================
# AI CASH MACHINE — variables de entorno (ejemplo)
# Copia este archivo a .env.local y rellena los valores.
# ⚠️ NUNCA subas .env.local a GitHub (ya está en .gitignore).
#
# Analogía: una variable de entorno es la COMBINACIÓN de tu caja fuerte.
# Va aparte del código para que nadie la vea aunque vea tu proyecto.
# ============================================================================

# --- Tu sitio ---
# URL pública de tu sitio (en local déjala así; en Vercel pon tu dominio real).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: CLIENTE (público, seguro de exponer) ---
# Project Settings → Data API. Es la "puerta de entrada" pública.
NEXT_PUBLIC_SUPABASE_URL=https://TU-REF.supabase.co
# Llave publicable (sb_publishable_... o anon). Es segura de exponer.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Supabase: SERVIDOR (SECRETO — nunca lleva NEXT_PUBLIC) ---
# Secret key / service_role (Project Settings → API Keys → "secret").
# Es la LLAVE MAESTRA de tu bodega: solo el servidor la usa.
# Sin esta llave la app corre en MODO DEMO (datos de muestra en memoria,
# cloudReady=false) — útil para ver todo antes de conectar tu base real.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Contraseña de la base, solo para correr migraciones manuales (no la usa la app).
SUPABASE_DB_PASSWORD=xxx

# --- Panel de administración ---
# YA NO SE USAN (ni ADMIN_CODE ni NEXT_PUBLIC_ADMIN_CODE): el panel de admin ahora
# solo abre con una sesión de administrador que pasó contraseña + captcha + doble
# factor. Un código fijo era una puerta trasera que se saltaba el doble factor.
# Puedes borrar estas dos variables de tu .env.local y de Vercel.
ADMIN_CODE=
NEXT_PUBLIC_ADMIN_CODE=

# --- Sesión del CRM (firma de la cookie de login de tu equipo) ---
# Secreto server-only para firmar la sesión de tus usuarios del CRM.
# Genera uno largo (32+ caracteres). Si falta, el CRM no permite iniciar sesión.
APP_SESSION_SECRET=pon-aqui-un-secreto-largo-de-al-menos-32-caracteres

# --- Píxeles de anuncios (OPCIONAL) ---
# Se cargan SOLO si el visitante acepta cookies en el banner. Déjalos vacíos
# si todavía no corres campañas pagadas.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Aviso por correo de cada lead nuevo (OPCIONAL, vía Resend) ---
# Crea tu cuenta gratis en resend.com → API Keys → Create API Key.
# Sin esta llave, el lead se guarda igual; solo no manda el correo de aviso.
RESEND_API_KEY=
# Remitente del correo. El de pruebas de Resend funciona sin configurar nada
# más; para usar tu propio dominio hay que verificarlo primero en Resend.
RESEND_FROM=Asegurarte <onboarding@resend.dev>

# --- AI Manager (Módulo 3): el "cerebro" de RORO, tu gerente digital ---
# Llave de la API de Claude: console.anthropic.com → API Keys → Create Key.
# SECRETA: nunca lleva NEXT_PUBLIC (solo la usa el servidor). Sin ella, el
# Panel de Mando funciona igual; solo RORO no puede responder preguntas.
# Consejo: en console.anthropic.com ponle un límite de gasto mensual.
ANTHROPIC_API_KEY=
# Tope de preguntas a RORO por mes (freno de gasto). Si no la pones: 200.
RORO_TOPE_MENSUAL=200

# --- Doble factor y captcha del login del CRM ---
# Captcha del login: Cloudflare Turnstile (gratis). Se activa SOLO si pones las DOS llaves.
#   1) Entra a https://dash.cloudflare.com → Turnstile → Add widget (Hostname: tu dominio y el de Vercel).
#   2) Copia la "Site Key" (pública) y la "Secret Key" (secreta).
#   3) Pónlas aquí y en Vercel (Production) y vuelve a publicar (Redeploy).
# Llaves de PRUEBA de Cloudflare (siempre pasan; solo para probar en local):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# El doble factor (código de la app autenticadora) NO necesita llaves: usa APP_SESSION_SECRET para
# cifrar el secreto de cada persona. ¡No cambies APP_SESSION_SECRET después de activarlo, o habrá
# que restablecer el 2FA de todos!
